# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf

# Preserve the reproducible upstream SQLCipher amalgamation byte-for-byte.
Telegram/SourceFiles/ayu/libs/sqlite/sqlite3.c text eol=lf
Telegram/SourceFiles/ayu/libs/sqlite/sqlite3.h text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary
